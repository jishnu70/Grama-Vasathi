<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GramaVasathi" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/earth_brown</item>
        <item name="colorSecondary">@color/golden_wheat</item>
        <item name="colorTertiary">@color/terracotta</item>
        <item name="colorSurface">@color/cream_white</item>
        <item name="colorSurfaceVariant">@color/warm_beige</item>
        <item name="android:colorBackground">@color/cream_white</item>
        <item name="android:windowBackground">@color/cream_white</item>
