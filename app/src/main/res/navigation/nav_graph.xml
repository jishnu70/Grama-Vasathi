<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment android:id="@+id/splashFragment" android:name="com.gramavasathi.ui.splash.SplashFragment" android:label="Splash">
        <action android:id="@+id/action_splashFragment_to_homeFragment" app:destination="@id/homeFragment" app:popUpTo="@id/splashFragment" app:popUpToInclusive="true" />
    </fragment>

    <fragment android:id="@+id/homeFragment" android:name="com.gramavasathi.ui.home.HomeFragment" android:label="Home">
        <action android:id="@+id/action_homeFragment_to_exploreFragment" app:destination="@id/exploreFragment" />
        <action android:id="@+id/action_homeFragment_to_hostTrainingFragment" app:destination="@id/hostTrainingFragment" />
        <action android:id="@+id/action_homeFragment_to_culturalGuideFragment" app:destination="@id/culturalGuideFragment" />
        <action android:id="@+id/action_homeFragment_to_homestayDetailFragment" app:destination="@id/homestayDetailFragment" />
    </fragment>

    <fragment android:id="@+id/exploreFragment" android:name="com.gramavasathi.ui.explore.ExploreFragment" android:label="Explore">
        <action android:id="@+id/action_exploreFragment_to_mapFragment" app:destination="@id/mapFragment" />
        <action android:id="@+id/action_exploreFragment_to_homestayDetailFragment" app:destination="@id/homestayDetailFragment" />
    </fragment>

    <fragment android:id="@+id/mapFragment" android:name="com.gramavasathi.ui.explore.MapFragment" android:label="Map" />

    <fragment android:id="@+id/homestayDetailFragment" android:name="com.gramavasathi.ui.detail.HomestayDetailFragment" android:label="Detail">
        <argument android:name="homestayId" app:argType="string" />
        <action android:id="@+id/action_homestayDetailFragment_to_bookingFragment" app:destination="@id/bookingFragment" />
    </fragment>

    <fragment android:id="@+id/bookingFragment" android:name="com.gramavasathi.ui.booking.BookingFragment" android:label="Booking">
        <argument android:name="homestayId" app:argType="string" />
    </fragment>

    <fragment android:id="@+id/hostTrainingFragment" android:name="com.gramavasathi.ui.host.HostTrainingFragment" android:label="Host" />
    <fragment android:id="@+id/culturalGuideFragment" android:name="com.gramavasathi.ui.cultural.CulturalGuideFragment" android:label="Guide" />
</navigation>
